# Only localhost / 127.0.0.1 / ::1 read VITE_DEPLOY_TARGET.
# lan: test the internal LAN API; internet: test Supabase on the same localhost URL.
# Deployed domains/IPs select by hostname, not by this setting.
VITE_DEPLOY_TARGET=lan
VITE_LAN_API_BASE=/api/fire-safety
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
# Never place PostgreSQL credentials, RSM service passwords or service-role keys here.
