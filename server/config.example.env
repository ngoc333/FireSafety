# Copy this file to .env.lan (gitignored). Node.js 22+ is required.
FS_LAN_HOST=127.0.0.1
FS_LAN_PORT=5088
FS_ORACLE_GATEWAY_URL=http://your-oracle-gateway-host:9090
FS_RSM_URL=http://your-rsm-gateway-host:5178
FS_RSM_SERVICE_ID=
FS_RSM_SERVICE_PASSWORD=
# Server-only random value of at least 32 characters:
FS_SESSION_SECRET=
# false ONLY during localhost development; use true behind HTTPS in LAN.
FS_COOKIE_SECURE=false
FS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
